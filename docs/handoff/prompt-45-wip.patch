diff --git c/crates/buture-git/src/diff.rs i/crates/buture-git/src/diff.rs
new file mode 100644
index 0000000..9872f45
--- /dev/null
+++ i/crates/buture-git/src/diff.rs
@@ -0,0 +1,409 @@
+//! Unified diff parsing keeps original patch bytes for checked hunk operations.
+use super::{GitError, LIMIT, Repository, args, execute, sensitive, validate_path};
+use std::{
+    io::Read,
+    path::{Path, PathBuf},
+    sync::mpsc,
+};
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Kind {
+    Context,
+    Added,
+    Removed,
+    Meta,
+}
+#[derive(Debug, Clone)]
+pub struct Line {
+    pub kind: Kind,
+    pub text: String,
+    pub old: Option<usize>,
+    pub new: Option<usize>,
+}
+#[derive(Debug, Clone)]
+pub struct Hunk {
+    pub label: String,
+    pub lines: Vec<Line>,
+    patch: Vec<u8>,
+}
+#[derive(Debug, Clone)]
+pub struct Diff {
+    pub path: PathBuf,
+    pub staged: bool,
+    pub binary: bool,
+    pub hunks: Vec<Hunk>,
+    pub lines: Vec<Line>,
+    header: Vec<u8>,
+    original: Vec<u8>,
+}
+fn numbers(header: &str) -> Option<(usize, usize)> {
+    let mut parts = header.split_whitespace();
+    if parts.next()? != "@@" {
+        return None;
+    }
+    let old = parts
+        .next()?
+        .strip_prefix('-')?
+        .split(',')
+        .next()?
+        .parse()
+        .ok()?;
+    let new = parts
+        .next()?
+        .strip_prefix('+')?
+        .split(',')
+        .next()?
+        .parse()
+        .ok()?;
+    Some((old, new))
+}
+impl Diff {
+    pub fn load(repo: &Repository, path: &Path, staged: bool) -> Result<Self, GitError> {
+        validate_path(path)?;
+        Self::parse(path.into(), staged, repo.diff(Some(path), staged)?)
+    }
+    pub fn parse(path: PathBuf, staged: bool, bytes: Vec<u8>) -> Result<Self, GitError> {
+        if bytes.len() > LIMIT {
+            return Err(GitError::TooLarge);
+        }
+        let binary = bytes.windows(16).any(|w| w == b"Git binary patch")
+            || bytes.starts_with(b"Binary files");
+        let mut header = vec![];
+        let mut hunks = vec![];
+        let mut lines = vec![];
+        let mut current = None::<Hunk>;
+        let (mut old, mut new) = (0usize, 0usize);
+        for raw in bytes.split_inclusive(|b| *b == b'\n') {
+            if raw.starts_with(b"@@ ") {
+                if let Some(hunk) = current.take() {
+                    hunks.push(hunk);
+                }
+                let label = String::from_utf8_lossy(raw)
+                    .trim_end()
+                    .chars()
+                    .take(1024)
+                    .collect::<String>();
+                (old, new) = numbers(&label).ok_or(GitError::InvalidPath)?;
+                current = Some(Hunk {
+                    label,
+                    lines: vec![],
+                    patch: raw.to_vec(),
+                });
+            } else if let Some(hunk) = &mut current {
+                hunk.patch.extend(raw);
+                let kind = match raw.first() {
+                    Some(b' ') => Kind::Context,
+                    Some(b'+') => Kind::Added,
+                    Some(b'-') => Kind::Removed,
+                    _ => Kind::Meta,
+                };
+                let text = String::from_utf8_lossy(raw.get(1..).unwrap_or(raw))
+                    .trim_end_matches('\n')
+                    .to_owned();
+                let line = Line {
+                    kind,
+                    text,
+                    old: if matches!(kind, Kind::Context | Kind::Removed) {
+                        Some(old)
+                    } else {
+                        None
+                    },
+                    new: if matches!(kind, Kind::Context | Kind::Added) {
+                        Some(new)
+                    } else {
+                        None
+                    },
+                };
+                if line.old.is_some() {
+                    old = old.checked_add(1).ok_or(GitError::TooLarge)?;
+                }
+                if line.new.is_some() {
+                    new = new.checked_add(1).ok_or(GitError::TooLarge)?;
+                }
+                hunk.lines.push(line.clone());
+                lines.push(line);
+                if lines.len() > 100000 {
+                    return Err(GitError::TooLarge);
+                }
+            } else {
+                header.extend(raw);
+            }
+        }
+        if let Some(hunk) = current {
+            hunks.push(hunk);
+        }
+        Ok(Self {
+            path,
+            staged,
+            binary,
+            hunks,
+            lines,
+            header,
+            original: bytes,
+        })
+    }
+    pub fn review_hunk(&self, repo: &Repository, index: usize) -> Result<HunkPlan, GitError> {
+        if self.binary || sensitive(&self.path) {
+            return Err(GitError::InvalidPath);
+        }
+        let hunk = self.hunks.get(index).ok_or(GitError::InvalidPath)?;
+        let mut patch = self.header.clone();
+        patch.extend(&hunk.patch);
+        let head = repo.head()?;
+        let plan = HunkPlan {
+            repo: repo.clone(),
+            path: self.path.clone(),
+            staged: self.staged,
+            expected: self.original.clone(),
+            patch,
+            head,
+        };
+        plan.check()?;
+        Ok(plan)
+    }
+}
+#[derive(Debug, Clone)]
+pub struct HunkPlan {
+    repo: Repository,
+    path: PathBuf,
+    staged: bool,
+    expected: Vec<u8>,
+    patch: Vec<u8>,
+    head: Option<String>,
+}
+pub struct ConfirmedHunk(HunkPlan);
+impl HunkPlan {
+    fn check(&self) -> Result<(), GitError> {
+        if self.repo.head()? != self.head
+            || self.repo.diff(Some(&self.path), self.staged)? != self.expected
+        {
+            return Err(GitError::Conflict);
+        }
+        let mut values = args(&["apply", "--cached", "--check", "--whitespace=nowarn"]);
+        if self.staged {
+            values.push("--reverse".into());
+        }
+        execute(
+            &self.repo.executable,
+            &self.repo.root,
+            &values,
+            Some(self.patch.clone()),
+        )?;
+        Ok(())
+    }
+    pub fn confirm(self) -> ConfirmedHunk {
+        ConfirmedHunk(self)
+    }
+}
+impl ConfirmedHunk {
+    pub fn execute(self) -> mpsc::Receiver<Result<String, GitError>> {
+        let (tx, rx) = mpsc::channel();
+        std::thread::spawn(move || {
+            let result = (|| {
+                self.0.check()?;
+                let mut values = args(&["apply", "--cached", "--whitespace=nowarn"]);
+                if self.0.staged {
+                    values.push("--reverse".into());
+                }
+                execute(
+                    &self.0.repo.executable,
+                    &self.0.repo.root,
+                    &values,
+                    Some(self.0.patch),
+                )?;
+                Ok(if self.0.staged {
+                    "Unstaged hunk; worktree preserved"
+                } else {
+                    "Staged hunk; worktree preserved"
+                }
+                .into())
+            })();
+            let _ = tx.send(result);
+        });
+        rx
+    }
+}
+fn content(repo: &Repository, path: &Path) -> Result<Option<Vec<u8>>, GitError> {
+    let target = repo.root.join(path);
+    match std::fs::symlink_metadata(&target) {
+        Ok(meta) => {
+            if meta.file_type().is_symlink()
+                || !meta.is_file()
+                || !std::fs::canonicalize(&target)?.starts_with(&repo.root)
+            {
+                return Err(GitError::InvalidPath);
+            }
+            let mut bytes = vec![];
+            std::fs::File::open(target)?
+                .take(LIMIT as u64 + 1)
+                .read_to_end(&mut bytes)?;
+            if bytes.len() > LIMIT {
+                return Err(GitError::TooLarge);
+            }
+            Ok(Some(bytes))
+        }
+        Err(e) if e.kind() == std::io::ErrorKind::NotFound => Ok(None),
+        Err(e) => Err(e.into()),
+    }
+}
+#[derive(Debug, Clone)]
+pub struct DiscardPlan {
+    repo: Repository,
+    pub path: PathBuf,
+    worktree: Option<Vec<u8>>,
+    index: Vec<u8>,
+}
+pub struct ConfirmedDiscard(DiscardPlan);
+impl DiscardPlan {
+    pub fn review(repo: &Repository, path: &Path) -> Result<Self, GitError> {
+        validate_path(path)?;
+        let worktree = content(repo, path)?;
+        let mut spec = std::ffi::OsString::from(":0:");
+        spec.push(path.as_os_str());
+        let index = execute(
+            &repo.executable,
+            &repo.root,
+            &["rev-parse".into(), "--verify".into(), spec],
+            None,
+        )?;
+        Ok(Self {
+            repo: repo.clone(),
+            path: path.into(),
+            worktree,
+            index,
+        })
+    }
+    pub fn confirm(self) -> ConfirmedDiscard {
+        ConfirmedDiscard(self)
+    }
+}
+impl ConfirmedDiscard {
+    pub fn execute(self) -> mpsc::Receiver<Result<String, GitError>> {
+        let (tx, rx) = mpsc::channel();
+        std::thread::spawn(move || {
+            let result = (|| {
+                let checked = DiscardPlan::review(&self.0.repo, &self.0.path)?;
+                if checked.worktree != self.0.worktree || checked.index != self.0.index {
+                    return Err(GitError::Conflict);
+                }
+                let mut values = args(&["restore", "--worktree", "--"]);
+                values.push(self.0.path.as_os_str().into());
+                execute(&self.0.repo.executable, &self.0.repo.root, &values, None)?;
+                Ok("Discarded reviewed worktree changes; index preserved".into())
+            })();
+            let _ = tx.send(result);
+        });
+        rx
+    }
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn parser_preserves_hunks_and_coordinates() {
+        let patch=b"diff --git a/a b/a\nindex 123..456 100644\n--- a/a\n+++ b/a\n@@ -1,2 +1,2 @@\n keep\n-old\n+new\n\\ No newline at end of file\n".to_vec();
+        let diff = Diff::parse("a".into(), false, patch).expect("diff");
+        assert_eq!(diff.hunks.len(), 1);
+        assert_eq!(diff.lines[1].old, Some(2));
+        assert_eq!(diff.lines[2].new, Some(2));
+        assert_eq!(diff.lines[3].kind, Kind::Meta);
+    }
+    #[test]
+    fn native_hunks_and_discard_guard_concurrent_changes() {
+        let Ok(owner) = Repository::discover(&std::env::current_dir().expect("cwd")) else {
+            return;
+        };
+        let Ok((name, email)) = owner.identity() else {
+            return;
+        };
+        let root = std::env::temp_dir().join(format!("buture-git-diff-{}", std::process::id()));
+        std::fs::create_dir_all(&root).expect("fixture");
+        execute(
+            &owner.executable,
+            &root,
+            &args(&["init", "-b", "main"]),
+            None,
+        )
+        .expect("init");
+        execute(
+            &owner.executable,
+            &root,
+            &args(&["config", "user.name", &name]),
+            None,
+        )
+        .expect("owner");
+        execute(
+            &owner.executable,
+            &root,
+            &args(&["config", "user.email", &email]),
+            None,
+        )
+        .expect("email");
+        let repo = Repository::discover(&root).expect("repo");
+        let path = PathBuf::from("source.txt");
+        let original = (0..30).map(|n| format!("line {n}\n")).collect::<String>();
+        std::fs::write(root.join(&path), &original).expect("source");
+        let wait = |plan: super::super::Plan| {
+            plan.confirm()
+                .execute()
+                .recv_timeout(std::time::Duration::from_secs(5))
+                .expect("event")
+                .expect("operation")
+        };
+        wait(
+            repo.review(super::super::Operation::Stage(vec![path.clone()]))
+                .expect("review"),
+        );
+        wait(
+            repo.review(super::super::Operation::Commit(
+                "[test] diff fixture".into(),
+            ))
+            .expect("review"),
+        );
+        let changed = original
+            .replace("line 1\n", "changed one\n")
+            .replace("line 25\n", "changed twenty five\n");
+        std::fs::write(root.join(&path), &changed).expect("edit");
+        let diff = Diff::load(&repo, &path, false).expect("diff");
+        assert_eq!(diff.hunks.len(), 2);
+        diff.review_hunk(&repo, 0)
+            .expect("hunk")
+            .confirm()
+            .execute()
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("event")
+            .expect("stage hunk");
+        assert!(
+            String::from_utf8(repo.diff(Some(&path), true).expect("staged"))
+                .expect("utf8")
+                .contains("changed one")
+        );
+        assert_eq!(
+            std::fs::read_to_string(root.join(&path)).expect("worktree"),
+            changed
+        );
+        let staged = Diff::load(&repo, &path, true).expect("staged");
+        staged
+            .review_hunk(&repo, 0)
+            .expect("review")
+            .confirm()
+            .execute()
+            .recv_timeout(std::time::Duration::from_secs(5))
+            .expect("event")
+            .expect("unstage");
+        let discard = DiscardPlan::review(&repo, &path).expect("discard review");
+        std::fs::write(root.join(&path), "owner newer edit").expect("owner edit");
+        assert!(matches!(
+            discard
+                .confirm()
+                .execute()
+                .recv_timeout(std::time::Duration::from_secs(5))
+                .expect("event"),
+            Err(GitError::Conflict)
+        ));
+        assert_eq!(
+            std::fs::read_to_string(root.join(&path)).expect("file"),
+            "owner newer edit"
+        );
+        std::fs::remove_dir_all(root).expect("cleanup");
+    }
+}
