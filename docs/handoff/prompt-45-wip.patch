diff --git c/crates/buture-ui/src/diff_view.rs i/crates/buture-ui/src/diff_view.rs
new file mode 100644
index 0000000..6802740
--- /dev/null
+++ i/crates/buture-ui/src/diff_view.rs
@@ -0,0 +1,248 @@
+//! Solid inline/side-by-side diff; checked hunk transactions leave the worktree untouched.
+use crate::Theme;
+use buture_git::{
+    GitError, Repository,
+    diff::{Diff, DiscardPlan, HunkPlan, Kind},
+};
+use std::{
+    path::{Path, PathBuf},
+    sync::{Arc, mpsc},
+};
+enum Prepared {
+    Hunk(HunkPlan),
+    Discard(DiscardPlan),
+}
+#[derive(Default)]
+pub struct DiffView {
+    pub open: bool,
+    repo: Option<Repository>,
+    diff: Option<Arc<Diff>>,
+    loading: Option<mpsc::Receiver<Result<Diff, GitError>>>,
+    planning: Option<mpsc::Receiver<Result<Prepared, GitError>>>,
+    operation: Option<mpsc::Receiver<Result<String, GitError>>>,
+    discard: Option<DiscardPlan>,
+    consent: bool,
+    side_by_side: bool,
+    pub message: String,
+    changed: bool,
+}
+impl DiffView {
+    pub fn load(&mut self, repo: Repository, path: PathBuf, staged: bool) {
+        self.open = true;
+        self.repo = Some(repo.clone());
+        self.diff = None;
+        self.discard = None;
+        let (tx, rx) = mpsc::channel();
+        self.loading = Some(rx);
+        std::thread::spawn(move || {
+            let _ = tx.send(Diff::load(&repo, &path, staged));
+        });
+    }
+    pub fn busy(&self) -> bool {
+        self.loading.is_some() || self.planning.is_some() || self.operation.is_some()
+    }
+    pub fn running(&self) -> bool {
+        self.operation.is_some()
+    }
+    pub fn take_changed(&mut self) -> bool {
+        std::mem::take(&mut self.changed)
+    }
+    pub fn poll(&mut self, trusted: bool) {
+        let loaded = self.loading.as_ref().and_then(|r| r.try_recv().ok());
+        if let Some(result) = loaded {
+            self.loading = None;
+            match result {
+                Ok(diff) => self.diff = Some(Arc::new(diff)),
+                Err(e) => self.message = e.to_string(),
+            }
+        }
+        let prepared = self.planning.as_ref().and_then(|r| r.try_recv().ok());
+        if let Some(result) = prepared {
+            self.planning = None;
+            match result {
+                Ok(Prepared::Hunk(plan)) if trusted => {
+                    self.operation = Some(plan.confirm().execute())
+                }
+                Ok(Prepared::Discard(plan)) if trusted => {
+                    self.discard = Some(plan);
+                    self.consent = false;
+                }
+                Ok(_) => self.message = "Repository trust changed; operation cancelled".into(),
+                Err(e) => self.message = e.to_string(),
+            }
+        }
+        let result = self.operation.as_ref().and_then(|r| r.try_recv().ok());
+        if let Some(result) = result {
+            self.operation = None;
+            self.message = match result {
+                Ok(message) => {
+                    self.changed = true;
+                    message
+                }
+                Err(e) => e.to_string(),
+            };
+            if let (Some(repo), Some(diff)) = (&self.repo, &self.diff) {
+                self.load(repo.clone(), diff.path.clone(), diff.staged);
+            }
+        }
+    }
+    pub fn review(&mut self, ctx: &egui::Context, trusted: bool, dirty: &[PathBuf]) {
+        let Some(plan) = &self.discard else {
+            return;
+        };
+        let mut apply = false;
+        let mut cancel = false;
+        let blocked = dirty.contains(&plan_path(self.repo.as_ref(), &plan.path));
+        egui::Modal::new(egui::Id::new("discard-diff")).show(ctx,|ui|{ui.heading("Discard worktree changes");ui.label(plan.path.display().to_string());ui.label("Restores the entire tracked file from the index. Unsaved editor buffers are blocked; changes made after this review cause a conflict.");ui.checkbox(&mut self.consent,"I confirm discarding the reviewed worktree changes");apply=ui.add_enabled(trusted&&self.consent&&!blocked,egui::Button::new("Discard reviewed file changes")).clicked();cancel=ui.button("Cancel").clicked();});
+        if apply && let Some(plan) = self.discard.take() {
+            self.operation = Some(plan.confirm().execute());
+        }
+        if cancel {
+            self.discard = None;
+        }
+    }
+    pub fn show(
+        &mut self,
+        ui: &mut egui::Ui,
+        theme: &Theme,
+        trusted: bool,
+        dirty: &[PathBuf],
+    ) -> Option<PathBuf> {
+        self.poll(trusted);
+        let mut open_file = None;
+        ui.horizontal(|ui| {
+            ui.heading("Diff");
+            ui.checkbox(&mut self.side_by_side, "Side by side");
+            if ui.button("Back to changes").clicked() {
+                self.open = false;
+            }
+        });
+        ui.label(&self.message);
+        if self.busy() {
+            ui.spinner();
+        }
+        let Some(diff) = self.diff.clone() else {
+            return None;
+        };
+        ui.horizontal(|ui| {
+            ui.label(diff.path.display().to_string());
+            ui.label(if diff.staged {
+                "Staged → HEAD"
+            } else {
+                "Worktree → Index"
+            });
+            if ui.button("Open source").clicked() {
+                open_file = Some(plan_path(self.repo.as_ref(), &diff.path));
+            }
+        });
+        if diff.binary {
+            ui.label("Binary diff: hunk editing is unavailable.");
+            return open_file;
+        }
+        if diff.hunks.is_empty() {
+            ui.label(
+                "No textual hunks. Untracked files can be staged as a whole in Source Control.",
+            );
+        }
+        let mut hunk = None;
+        let mut discard = false;
+        ui.horizontal_wrapped(|ui| {
+            for (index, part) in diff.hunks.iter().enumerate() {
+                if ui
+                    .add_enabled(
+                        trusted && !self.busy(),
+                        egui::Button::new(format!(
+                            "{} hunk {}",
+                            if diff.staged { "Unstage" } else { "Stage" },
+                            index + 1
+                        )),
+                    )
+                    .on_hover_text(&part.label)
+                    .clicked()
+                {
+                    hunk = Some(index);
+                }
+            }
+            if !diff.staged
+                && ui
+                    .add_enabled(
+                        trusted
+                            && !self.busy()
+                            && !dirty.contains(&plan_path(self.repo.as_ref(), &diff.path)),
+                        egui::Button::new("Discard file…"),
+                    )
+                    .clicked()
+            {
+                discard = true;
+            }
+        });
+        if let Some(repo) = self.repo.clone() {
+            if let Some(index) = hunk {
+                let diff = diff.clone();
+                let (tx, rx) = mpsc::channel();
+                self.planning = Some(rx);
+                std::thread::spawn(move || {
+                    let _ = tx.send(diff.review_hunk(&repo, index).map(Prepared::Hunk));
+                });
+            } else if discard {
+                let path = diff.path.clone();
+                let (tx, rx) = mpsc::channel();
+                self.planning = Some(rx);
+                std::thread::spawn(move || {
+                    let _ = tx.send(DiscardPlan::review(&repo, &path).map(Prepared::Discard));
+                });
+            }
+        }
+        egui::ScrollArea::both().show_rows(ui, 22.0, diff.lines.len(), |ui, rows| {
+            for index in rows {
+                let line = &diff.lines[index];
+                let color = match line.kind {
+                    Kind::Added => theme.semantic.success,
+                    Kind::Removed => theme.semantic.error,
+                    _ => theme.text.secondary,
+                };
+                let text = line.text.chars().take(16000).collect::<String>();
+                let old = line.old.map(|n| n.to_string()).unwrap_or_default();
+                let new = line.new.map(|n| n.to_string()).unwrap_or_default();
+                if self.side_by_side {
+                    ui.columns(2, |cols| {
+                        if line.kind != Kind::Added {
+                            cols[0].add(
+                                egui::Label::new(
+                                    egui::RichText::new(format!("{old:>5} {text}"))
+                                        .monospace()
+                                        .color(color),
+                                )
+                                .wrap_mode(egui::TextWrapMode::Extend),
+                            );
+                        }
+                        if line.kind != Kind::Removed {
+                            cols[1].add(
+                                egui::Label::new(
+                                    egui::RichText::new(format!("{new:>5} {text}"))
+                                        .monospace()
+                                        .color(color),
+                                )
+                                .wrap_mode(egui::TextWrapMode::Extend),
+                            );
+                        }
+                    });
+                } else {
+                    ui.add(
+                        egui::Label::new(
+                            egui::RichText::new(format!("{old:>5} {new:>5} {text}"))
+                                .monospace()
+                                .color(color),
+                        )
+                        .wrap_mode(egui::TextWrapMode::Extend),
+                    );
+                }
+            }
+        });
+        open_file
+    }
+}
+fn plan_path(repo: Option<&Repository>, path: &Path) -> PathBuf {
+    repo.map(|r| r.root.join(path))
+        .unwrap_or_else(|| path.into())
+}
